# release package staging (published via GitHub Releases, not git)
_pkg/

# parser repro fixture output
generator/_ptest/out/
generator/_ptest/nondet.txt

# The nine binding projects are produced by the generator on every build
# (generator/regen-all.ps1) and published where CMake reads them; they are
# build output, never committed. generator/curated/ holds the hand-maintained
# sources that are re-attached to the fresh output.
/generated_cpp/
/regen-test/

# test.ps1 output: the evaluator stdout/stderr and the surface coverage suite it
# derives from generated_cpp/ on every run (tools/surface-coverage.ps1)
/logs/
