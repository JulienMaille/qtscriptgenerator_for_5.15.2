#define __cplusplus 1

#define __STDC__

// Qt
#define QOBJECTDEFS_H

// not yet supported
#define Q_SLOTS slots
// Expand away the slots keyword as well; leaving it as an identifier makes
// the legacy parser choke on 'public slots:' sections (Qt 5 headers use
// Q_SLOTS everywhere, which the line above turns into the word 'slots').
// Qt itself defines 'slots' to nothing for the same reason.
#define slots
#define Q_SIGNALS signals
#define Q_FLAGS(a)
#define Q_PRIVATE_SLOT(a, b)
#define Q_DECLARE_INTERFACE(a,b)
#define Q_INTERFACES(a)
#define Q_GADGET
#define Q_OVERRIDE(a)
#define Q_OS_OS2
#define Q_NO_USING_KEYWORD

// Qt 6: version-gated macros (QT6_ONLY/QT7_ONLY in qtversionchecks.h) need
// QT_VERSION_MAJOR; the legacy rpp run leaves it undefined (headers that
// would define it are skipped or evaluated too late), so QT6_ONLY(...) leaks
// literally into class heads (e.g. QIPv6Address) and drops the class.
// NOTE: rpp evaluates `#if QT_VERSION_MAJOR == 6` with undefined identifiers
// as 0, which also breaks `#if QT_VERSION < QT_VERSION_CHECK(7,0,0)` guards
// (they take the Qt7 branch). Define the full version triple for the target.
#define QT_VERSION_MAJOR 6
#define QT_VERSION_MINOR 8
#define QT_VERSION_PATCH 3
#define QT_VERSION_STR "6.8.3"

// There are symbols in Qt that exist in Debug but
// not in release
#define QT_NO_DEBUG

#define QT_JAMBI_RUN
